{
  "manifest_version": 3,

  "name": "Misstter",
  "description": "Misstter",
  "version": "2.0.1",

  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "icons/icon_16x16.png",
    "32": "icons/icon_32x32.png",
    "128": "icons/icon_128x128.png",
    "256": "icons/icon_256x256.png",
    "512": "icons/icon_512x512.png"
  },

  "content_scripts": [
      {
        "matches": [
          "https://twitter.com/*",
          "https://tweetdeck.twitter.com/*",
          
          "https://pro.twitter.com/*",

          "https://x.com/*",
          "https://pro.x.com/*"
        ],
          "js": ["js/vendor.js", "js/content_script.js"],
          "run_at": "document_start"
      },
      {
          "matches": [
            "https://twitter.com/*",
            "https://tweetdeck.twitter.com/*",
            "https://pro.twitter.com/*",
            "https://x.com/*",
            "https://pro.x.com/*"
          ],
          "js": ["js/misskey_fetch_patch.js"],
          "run_at": "document_start",
          "world": "MAIN"
      }
  ],

  "background": {
    "scripts": [
      "js/background.js"
    ]
  },

  "permissions": [ 
    "storage" 
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "web_accessible_resources": [
    { 
      "resources": [
        "misskey_icon.png",
        "js/misskey_fetch_patch.js"
      ], 
      "matches": [
        "https://twitter.com/*",
        "https://tweetdeck.twitter.com/*",
        
        "https://pro.twitter.com/*",

        "https://x.com/*",
        "https://pro.x.com/*"
      ] 
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "{7eaad148-40a3-426c-bb3e-0daf01a0913c}"
    }
  }
}
